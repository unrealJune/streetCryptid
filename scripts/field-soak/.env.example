# Copy to scripts/field-soak/.env (gitignored) and fill in. Real environment variables override.
# Secrets are NOT kept here. They're files in FIELD_SOAK_SECRETS_DIR, each chmod 600:
#   grafana-token                   Grafana service-account token (Viewer)
#   field-soak-discord-webhook      webhook URL (send-only alerts; fallback when there is no bot)
#   field-soak-discord-bot-token    bot token (read + reply in the channel; needs Message Content intent)

# Grafana that fronts the Tempo the phones' telemetry lands in (datasource proxy, uid "tempo").
FIELD_SOAK_GRAFANA_URL=https://grafana.example.com

# Apple Developer Team that signs the local app build and the WebDriverAgent runner.
FIELD_SOAK_TEAM_ID=ABCDE12345

# The test iPhone's UDID (`xcrun devicectl list devices`). config.json's "udid" wins if set.
FIELD_SOAK_UDID=00000000-0000000000000000

# Optional.
# FIELD_SOAK_SECRETS_DIR=~/.config/streetcryptid
# FIELD_SOAK_STATE=~/.local/state/streetcryptid-field
# FIELD_SOAK_PORT=47811
