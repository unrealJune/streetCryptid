{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "cryptid-generator": ["./modules/cryptid-generator/index.ts"],
      "iroh-location": ["./modules/iroh-location/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // Replaces expo/tsconfig.base's list rather than adding to it, so it repeats that list.
  // website/ has its own bun tests (website/README.md).
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "website"
  ]
}
