# Public runtime endpoints. Copy to .env.local and replace with reachable deployments.
# This source must expose Martin XYZ tiles plus /bundle/v1 z10 privacy bundles.
EXPO_PUBLIC_TILE_URL=https://tiles.example.com/planet
EXPO_PUBLIC_IROH_RELAY_URLS=https://relay.example.com
EXPO_PUBLIC_IROH_RELAY_TOKEN=replace-with-limited-scope-client-token
EXPO_PUBLIC_PAIR_MAILBOX_URL=https://mailbox.example.com

# Optional offline-delivery trail stash (https://github.com/unrealJune/trail-stash). Leave unset to
# disable the feature (peer-only reconciliation). Both URL and ticket are required to enable it; PSK
# is the anti-abuse
# pre-shared key (mirrors the relay token) and must match the server's TRAIL_STASH_PSK.
EXPO_PUBLIC_TRAIL_STASH_URL=https://stash.example.com
EXPO_PUBLIC_TRAIL_STASH_TICKET=replace-with-stash-node-endpoint-ticket
EXPO_PUBLIC_TRAIL_STASH_PSK=replace-with-limited-scope-client-token

# For the e2e network-chaos harness (scripts/e2e/scenarios/chaos-*.yaml) only: point the three
# TRAIL_STASH_* values above at a local instance instead (`just e2e-local-stash` prints the exact
# lines and its own generated ticket/PSK), then rebuild the dev client — these are inlined at
# bundle time, so an already-built app can't be repointed without one. See
# scripts/e2e/ensure-local-stash.sh and lib/netchaos.sh.

# DEVELOPER-ONLY telemetry (traces + logs → an OTLP/HTTP collector; see infra/otel/README.md).
# Set to an endpoint the PHONE can reach: a LAN infra/otel stack (http://<lan-ip>:4318), or your
# own deployed collector. Unset ⇒ nothing is exported and the local journal is all you get.
#
# Deliberately a placeholder, like every other value in this file. The collector this points at in
# a real build accepts whatever is POSTed to it, so its address is not something to publish in a
# public repo — keep the real one in .env.local (git-ignored) or the EAS environment.
EXPO_PUBLIC_OTEL_ENDPOINT=https://otlp.example.com

# Compiles developer telemetry into the bundle. Without `=1`, metro.config.js resolves
# `@/features/dev/telemetry` to `index.noop.ts` and the exporter, shipper, SQLite journal and
# console bridge are not in the bundle at all — the JS counterpart of the native core's `otel`
# cargo feature. Store builds leave this unset; `scripts/check-release-telemetry.mjs` enforces it.
EXPO_PUBLIC_DEV_TELEMETRY=1
