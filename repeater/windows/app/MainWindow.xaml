<Window
    x:Class="StreetCryptid.Repeater.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StreetCryptid.Repeater.Controls">
    <Grid x:Name="Root" Background="{ThemeResource CryptidGround}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar"
                  Foreground="{ThemeResource CryptidInk}" Background="Transparent">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/repeater-256.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="StatusText" Text="STARTING" VerticalAlignment="Center"
                               FontFamily="ms-appx:///Assets/Plex.ttf#IBM Plex Mono" FontSize="11" />
                    <Button x:Name="SettingsButton" Click="SettingsClicked" AutomationProperties.Name="Settings"
                            ToolTipService.ToolTip="Settings" Background="Transparent" BorderThickness="0">
                        <FontIcon x:Name="SettingsGlyph" Glyph="&#xE713;" FontSize="16" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>
        <Grid Grid.Row="1">
            <controls:DotGridBackdrop x:Name="Field" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
            <Border x:Name="Island" Margin="40,24" Padding="32" MaxWidth="620"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource CryptidPanel}" BorderBrush="{ThemeResource CryptidLine}"
                    BorderThickness="1" CornerRadius="6">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="12" AutomationProperties.Name="streetCryptid repeater">
                        <Image x:Name="Logo" Width="40" Height="40" VerticalAlignment="Center"
                               AutomationProperties.AccessibilityView="Raw">
                            <Image.Source>
                                <SvgImageSource x:Name="LogoSource" UriSource="ms-appx:///Assets/mothman-logo.svg"
                                                RasterizePixelWidth="80" RasterizePixelHeight="80" />
                            </Image.Source>
                        </Image>
                        <TextBlock FontFamily="ms-appx:///Assets/Rajdhani.ttf#Rajdhani SemiBold"
                                   FontSize="30" Foreground="{ThemeResource CryptidInk}">
                            <Run Text="street" /><Run Text="Cryptid" Foreground="{ThemeResource CryptidSignal}" />
                        </TextBlock>
                        <Border Width="1" Height="26" Background="{ThemeResource CryptidLine}" />
                        <TextBlock Text="repeater" FontFamily="ms-appx:///Assets/Rajdhani.ttf#Rajdhani SemiBold"
                                   FontSize="24" VerticalAlignment="Center" Foreground="{ThemeResource CryptidInk}" />
                    </StackPanel>
                    <StackPanel x:Name="PageContent" Spacing="20">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="PageOffset" />
                    </StackPanel.RenderTransform>
                    <StackPanel x:Name="SetupPanel" Spacing="14" Visibility="Collapsed">
                        <TextBlock x:Name="SettingsHeading" Text="Setup" FontSize="24" FontFamily="ms-appx:///Assets/Rajdhani.ttf#Rajdhani SemiBold" />
                        <ToggleSwitch x:Name="ServiceChoice" Header="Run as a Windows service" IsOn="True" Toggled="SaveDraft" />
                        <TextBlock x:Name="ServiceHelp" TextWrapping="Wrap" Opacity=".7"
                                   Text="Keeps carrying before anyone signs in and after you sign out. Windows asks an administrator to approve this once, and again when an update changes the service." />
                        <ToggleSwitch x:Name="AwakeChoice" Header="Keep this PC awake on mains power" Toggled="SaveDraft" />
                        <TextBlock x:Name="AwakeHelp" TextWrapping="Wrap" Opacity=".7"
                                   Text="A sleeping PC carries nothing. On battery, Windows sleeps as usual." />
                        <ToggleSwitch x:Name="DiagnosticsChoice" Header="Send diagnostics" IsOn="True" Toggled="SaveDraft" />
                        <TextBlock x:Name="DiagnosticsHelp" TextWrapping="Wrap" Opacity=".7"
                                   Text="Preview builds report how this repeater is running (counts, timings, errors) to the streetCryptid developers. Never locations: everything it carries is encrypted for your friends." />
                        <ToggleSwitch x:Name="StartupChoice" Header="Open the app with Windows" Toggled="SaveDraft" />
                        <TextBlock x:Name="StartupHelp" Text="Shows the repeater in the tray after you sign in, and keeps updates arriving." TextWrapping="Wrap" Opacity=".7" />
                        <ToggleSwitch x:Name="TrayChoice" Header="Start in tray at sign-in" IsOn="True" Toggled="SaveDraft" />
                        <ToggleSwitch x:Name="CloseChoice" Header="Keep running when closed" IsOn="True" Toggled="SaveDraft" />
                        <TextBlock x:Name="TrayHelp" Text="Without the service, the repeater stops when the app does." TextWrapping="Wrap" Opacity=".7" />
                        <ToggleSwitch x:Name="UpdatesChoice" Header="Automatic updates" IsOn="True" Toggled="SaveDraft" />
                        <TextBlock x:Name="UpdateHelp" Text="Download improvements; apply on restart." TextWrapping="Wrap" Opacity=".7" />
                        <Button x:Name="SaveButton" Content="CONTINUE" Click="SaveClicked" Style="{StaticResource CryptidButton}" />
                        <TextBlock x:Name="VersionText" FontSize="12" Opacity=".7" TextWrapping="Wrap"
                                   FontFamily="ms-appx:///Assets/Plex.ttf#IBM Plex Mono" />
                    </StackPanel>
                    <StackPanel x:Name="ClaimPanel" Spacing="16" Visibility="Collapsed"
                                HorizontalAlignment="Center">
                        <Viewbox MaxWidth="300" Stretch="Uniform">
                            <controls:ClaimQr x:Name="Qr" AutomationProperties.Name="One-time repeater claim code" />
                        </Viewbox>
                        <Button Content="COPY CLAIM LINK" Click="CopyClicked" HorizontalAlignment="Center"
                                Style="{StaticResource CryptidButton}" />
                    </StackPanel>
                    <StackPanel x:Name="RunningPanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock x:Name="MemberCount" FontFamily="ms-appx:///Assets/Rajdhani.ttf#Rajdhani SemiBold" FontSize="24" />
                        <TextBlock x:Name="ContentStatus" FontSize="14" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="24" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Received" />
                            <TextBlock Text="Sent" Grid.Column="1" />
                            <TextBlock x:Name="ReceivedText" Grid.Row="1" FontFamily="ms-appx:///Assets/Plex.ttf#IBM Plex Mono" FontSize="18" />
                            <TextBlock x:Name="SentText" Grid.Row="1" Grid.Column="1" FontFamily="ms-appx:///Assets/Plex.ttf#IBM Plex Mono" FontSize="18" />
                            <TextBlock x:Name="ConnectionText" Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Traffic since this repeater started, including sync overhead."
                                   FontSize="12" TextWrapping="Wrap" />
                        <TextBlock x:Name="HostText" FontSize="12" TextWrapping="Wrap" />
                        <Border Height="1" Background="{ThemeResource CryptidLine}" />
                        <ScrollViewer MaxHeight="240">
                            <StackPanel x:Name="Members" Spacing="12" />
                        </ScrollViewer>
                        <TextBlock x:Name="PolicyStatus" FontSize="12" TextWrapping="Wrap" />
                        <Button x:Name="ReleaseButton" Content="RELEASE THIS REPEATER" Click="ReleaseClicked"
                                Style="{StaticResource CryptidButton}"
                                ToolTipService.ToolTip="Stop carrying everyone and show a new claim code" />
                    </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="UpdateServiceButton" Content="UPDATE SERVICE" Click="UpdateServiceClicked"
                            Style="{StaticResource CryptidButton}" Visibility="Collapsed" />
                    <Button x:Name="RetryButton" Content="RETRY" Click="RetryClicked"
                            Style="{StaticResource CryptidButton}" Visibility="Collapsed" />
                    <Button x:Name="UpdateButton" Content="CHECK FOR UPDATES" Click="UpdateClicked"
                            Style="{StaticResource CryptidButton}" Visibility="Collapsed" />
                    <Button x:Name="RestartButton" Content="RESTART TO UPDATE" Click="RestartClicked"
                            Style="{StaticResource CryptidButton}" Visibility="Collapsed" />
                </StackPanel>
            </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
