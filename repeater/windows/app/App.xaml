<Application
    x:Class="StreetCryptid.Repeater.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CryptidGround" Color="#EEF2F5" />
                    <SolidColorBrush x:Key="CryptidPanel" Color="#F7FFFFFF" />
                    <SolidColorBrush x:Key="CryptidInk" Color="#152633" />
                    <SolidColorBrush x:Key="CryptidLine" Color="#D6DEE4" />
                    <SolidColorBrush x:Key="CryptidSignal" Color="#28794F" />
                    <SolidColorBrush x:Key="CryptidDanger" Color="#C42B1C" />
                    <SolidColorBrush x:Key="CryptidDangerInk" Color="White" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CryptidGround" Color="#0A1420" />
                    <SolidColorBrush x:Key="CryptidPanel" Color="#F70B1826" />
                    <SolidColorBrush x:Key="CryptidInk" Color="#DCEBF0" />
                    <SolidColorBrush x:Key="CryptidLine" Color="#263C49" />
                    <SolidColorBrush x:Key="CryptidSignal" Color="#6FD08A" />
                    <SolidColorBrush x:Key="CryptidDanger" Color="#C42B1C" />
                    <SolidColorBrush x:Key="CryptidDangerInk" Color="White" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CryptidGround" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CryptidPanel" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CryptidInk" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CryptidLine" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CryptidSignal" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CryptidDanger" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CryptidDangerInk" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#39875C" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#459B6B" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#2D704B" />
            <Style x:Key="CryptidButton" TargetType="Button">
                <Setter Property="FontFamily" Value="ms-appx:///Assets/Rajdhani.ttf#Rajdhani SemiBold" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="BorderBrush" Value="{ThemeResource CryptidInk}" />
            </Style>
            <!-- Hover and pressed come from the button's own resources (lightweight styling). -->
            <Style x:Key="CryptidDangerButton" TargetType="Button" BasedOn="{StaticResource CryptidButton}">
                <Setter Property="Background" Value="{ThemeResource CryptidDanger}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CryptidDanger}" />
                <Setter Property="Foreground" Value="{ThemeResource CryptidDangerInk}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
